diff --git a/fe/fe-core/src/test/java/com/starrocks/http/QueryCorruptionHttpSenderTest.java b/fe/fe-core/src/test/java/com/starrocks/http/QueryCorruptionHttpSenderTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..e663ad4eeaa49376c8de195a1e0347024301094e
--- /dev/null
+++ b/fe/fe-core/src/test/java/com/starrocks/http/QueryCorruptionHttpSenderTest.java
@@ -0,0 +1,189 @@
